{
  "collectionName": "components_content_galery_items",
  "info": {
    "displayName": "Galerie — fotka",
    "icon": "picture",
    "description": "Jedna fotka galerie „Naše práce“ na hlavní stránce: služba (čip filtru a štítek), sekce rezervace (tlačítko „Rezervovat“ otevře /book s rozbalenou sekcí) a popisek v prohlížeči."
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "service": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::service.service"
    },
    "bookingSection": {
      "type": "enumeration",
      "enum": [
        "Nehty",
        "Oboci",
        "Rasy_barveni_a_pece",
        "Prodluzovani_ras"
      ]
    },
    "caption": {
      "type": "string",
      "maxLength": 60
    },
    "description": {
      "type": "text",
      "maxLength": 400
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
